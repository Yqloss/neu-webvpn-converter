{
  "manifest_version": 3,
  "name": "东北大学 WebVPN 地址转换",
  "version": "1.1.0",
  "description": "导航时自动转换 WebVPN 和普通网址，支持切换方向和自定义 URL 正则。",
  "permissions": ["storage", "webNavigation", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [{ "resources": ["redirect.html"], "matches": ["<all_urls>"] }],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WebVPN 转换设置", "default_popup": "settings.html" },
  "options_page": "settings.html"
}
